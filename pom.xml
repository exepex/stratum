<?xml version="1.0" encoding="UTF-8"?>
<!--
  Builds every Stratum module in one run. It is also the parent of stratum-bom and stratum-build-rules,
  which cannot inherit stratum-build-parent, so that their POMs are flattened too.
  Stratum's version is set once, as revision in .mvn/maven.config. Dependency versions live in
  platform/stratum-bom, plugin versions in platform/stratum-build-parent.
  stratum-bom and stratum-build-rules cannot inherit spring-boot-starter-parent, so this POM pins the
  plugins they run to the versions that spring-boot-starter-parent sets in stratum-build-parent. When
  the Spring Boot version changes, copy its plugin versions here too.
  Keep <properties> and <pluginManagement> sorted by name.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.exepex.stratum</groupId>
  <artifactId>stratum</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>Stratum</name>
  <description>Builds every Stratum module: platform, shared libraries and starters.</description>

  <modules>
    <!-- Platform: versions, build rules and parent POMs -->
    <module>platform/stratum-bom</module>
    <module>platform/stratum-build-parent</module>
    <module>platform/stratum-build-rules</module>
    <module>platform/stratum-library-parent</module>
    <module>platform/stratum-parent</module>

    <!-- Shared libraries -->
    <module>libs/stratum-core</module>
    <module>libs/stratum-test</module>

    <!-- Starters -->
    <module>starters/stratum-starter-cache</module>
    <module>starters/stratum-starter-data-jpa</module>
    <module>starters/stratum-starter-http-client</module>
    <module>starters/stratum-starter-kafka</module>
    <module>starters/stratum-starter-logging</module>
    <module>starters/stratum-starter-oauth2-client</module>
    <module>starters/stratum-starter-observability</module>
    <module>starters/stratum-starter-resilience</module>
    <module>starters/stratum-starter-security</module>
    <module>starters/stratum-starter-web</module>
  </modules>

  <properties>
    <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven-site-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Fails the build of this POM and its two children if a plugin they use has no version. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>stratum-enforce-plugin-versions</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requirePluginVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The same plugin and settings as in stratum-build-parent, which this POM cannot share. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
          <updatePomFile>true</updatePomFile>
        </configuration>
        <executions>
          <execution>
            <id>stratum-flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>stratum-flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
