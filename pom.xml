<?xml version="1.0" encoding="UTF-8"?>
<!--
  Builds every Stratum module in one run, and is the one place where Stratum sets a version.

  - The Spring Boot version is the version of the parent below. Spring Boot's parent sets the
    versions of every library and plugin Spring Boot manages; Stratum never overrides them (ST-ENG-61).
  - <properties> holds every other version Stratum chooses: Java, the build tools and plugins Spring
    Boot does not manage, and the libraries stratum-bom manages. No other POM writes a version number.
  - Stratum's own version is revision in .mvn/maven.config.
  - Every Stratum POM inherits this one, directly or through stratum-build-parent.
  Keep <properties> and <pluginManagement> sorted by name.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.exepex.stratum</groupId>
  <artifactId>stratum</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>Stratum</name>
  <description>Builds every Stratum module and sets every version Stratum chooses.</description>

  <modules>
    <!-- Platform: versions, build rules and parent POMs -->
    <module>platform/stratum-bom</module>
    <module>platform/stratum-build-parent</module>
    <module>platform/stratum-build-rules</module>
    <module>platform/stratum-library-parent</module>
    <module>platform/stratum-parent</module>

    <!-- Shared libraries -->
    <module>libs/stratum-core</module>
    <module>libs/stratum-test</module>

    <!-- Starters -->
    <module>starters/stratum-starter-batch</module>
    <module>starters/stratum-starter-cache</module>
    <module>starters/stratum-starter-cli</module>
    <module>starters/stratum-starter-data-jpa</module>
    <module>starters/stratum-starter-http-client</module>
    <module>starters/stratum-starter-kafka</module>
    <module>starters/stratum-starter-logging</module>
    <module>starters/stratum-starter-microservice</module>
    <module>starters/stratum-starter-oauth2-client</module>
    <module>starters/stratum-starter-observability</module>
    <module>starters/stratum-starter-resilience</module>
    <module>starters/stratum-starter-security</module>
    <module>starters/stratum-starter-web</module>
    <module>starters/stratum-starter-web-ui</module>
  </modules>

  <properties>
    <checkstyle.version>14.3.0</checkstyle.version>
    <dependency-check-maven.version>13.0.0</dependency-check-maven.version>
    <extra-enforcer-rules.version>1.12.1</extra-enforcer-rules.version>
    <findsecbugs-plugin.version>1.14.0</findsecbugs-plugin.version>
    <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
    <google-java-format.version>1.36.1</google-java-format.version>
    <jacoco-maven-plugin.version>0.8.16</jacoco-maven-plugin.version>
    <java.version>25</java.version>
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
    <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
    <pmd.version>7.28.0</pmd.version>
    <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
    <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven-site-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Fails the build if a plugin has no version. Every Stratum module and every service that uses
           stratum-parent inherits this check. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>stratum-enforce-plugin-versions</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requirePluginVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Writes ${revision} as a fixed version into the installed POM. stratum-parent stops it for
           services, and stratum-bom changes its mode. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
          <updatePomFile>true</updatePomFile>
        </configuration>
        <executions>
          <execution>
            <id>stratum-flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>stratum-flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
