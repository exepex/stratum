<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.exepex.stratum</groupId>
    <artifactId>stratum-library-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/stratum-library-parent/pom.xml</relativePath>
  </parent>

  <artifactId>stratum-test</artifactId>

  <name>Stratum test</name>
  <description>Test support: the checks every Stratum starter's tests share, a PostgreSQL container for services' integration tests, and, planned, JUnit 5, AssertJ, Mockito, more containers, HTTP stubs and JWT helpers.</description>

  <!-- Teams add this module in test scope only, so its libraries never reach a running service. -->
  <dependencies>
    <dependency>
      <groupId>com.exepex.stratum</groupId>
      <artifactId>stratum-core</artifactId>
    </dependency>
    <!-- The starter architecture rules (ST-TEST-21). The parent adds ArchUnit for tests only; the
         checks here need it at compile time. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <!-- Waits for a log line written on a server thread, in LogLineCapture. -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
    </dependency>
    <!-- Reads the error bodies of the web starters in checkProblemDetails. -->
    <dependency>
      <groupId>com.jayway.jsonpath</groupId>
      <artifactId>json-path</artifactId>
    </dependency>
    <!-- PostgresContainerConfiguration. Optional, so a module or service that uses stratum-test gets
         none of them unless it tests against PostgreSQL: it then adds spring-boot-testcontainers and
         testcontainers-postgresql itself; spring-boot-starter-test already brings spring-boot-test. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The data source and the PostgreSQL driver that PostgresContainerConfigurationIntegrationTest
         connects with, as a service's data starter brings them. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
