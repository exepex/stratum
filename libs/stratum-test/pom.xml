<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.exepex.stratum</groupId>
    <artifactId>stratum-library-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/stratum-library-parent/pom.xml</relativePath>
  </parent>

  <artifactId>stratum-test</artifactId>

  <name>Stratum test</name>
  <description>The base test dependency for services and for Stratum's own modules: Spring Boot's test starter (JUnit, AssertJ, Mockito, Spring test support), a loader for configuration files in auto-configuration tests, and sample trace, span and correlation IDs.</description>

  <!-- Add with <scope>test</scope>. It does not depend on stratum-core, so that stratum-core's own
       tests can use it: Maven forbids a dependency cycle, even through test scope. -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
    </dependency>
    <!-- SLF4J's logging context (MDC), where LoggingContextIds puts the sample IDs. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
  </dependencies>
</project>
