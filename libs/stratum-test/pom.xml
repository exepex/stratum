<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.exepex.stratum</groupId>
    <artifactId>stratum-library-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/stratum-library-parent/pom.xml</relativePath>
  </parent>

  <artifactId>stratum-test</artifactId>

  <name>Stratum test</name>
  <description>Test support: the helpers and checks that several Stratum modules' tests share, and PostgreSQL and Redis containers for services' integration tests.</description>

  <!-- Teams add this module in test scope only, so its libraries never reach a running service. -->
  <dependencies>
    <dependency>
      <groupId>com.exepex.stratum</groupId>
      <artifactId>stratum-core</artifactId>
    </dependency>
    <!-- The starter architecture rules (ST-TEST-21). The parent adds ArchUnit for tests only; the
         checks here need it at compile time. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <!-- Waits for a log line written on a server thread, in LogLineCapture. -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
    </dependency>
    <!-- Reads the error bodies of the web starters in checkProblemDetails. -->
    <dependency>
      <groupId>com.jayway.jsonpath</groupId>
      <artifactId>json-path</artifactId>
    </dependency>
    <!-- Counts the server's request timers in WebTestSupport.getAndAwaitTimer. Optional: a module
         that calls it already has Micrometer through the observability or actuator starter. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- PostgresContainerConfiguration and RedisContainerConfiguration. Optional, so a module or
         service that uses stratum-test gets none of them unless it tests against a container: it
         then adds spring-boot-testcontainers itself, which brings Testcontainers' GenericContainer
         for Redis, and testcontainers-postgresql for PostgreSQL; spring-boot-starter-test already
         brings spring-boot-test. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- PostgresJdbcContainerConfiguration names Spring Boot's JdbcConnectionDetails. Optional for
         the same reason: a module that tests against PostgreSQL already has it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jdbc</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Loads stratum-core's OneShotContextScheduledExecutorService, whose supertype comes from this
         library, which stratum-core declares optional, so core's API list can name it. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>context-propagation</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>META-INF/stratum/**</exclude>
        </excludes>
      </resource>
      <!-- Writes the test container images, properties of the root pom.xml, into the jar, so each
           image is written in one place (ST-ENG-60). ContainerImagesTest fails if a value is
           left unfilled. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>META-INF/stratum/**</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
