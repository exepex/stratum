<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.exepex.stratum</groupId>
    <artifactId>stratum-library-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/stratum-library-parent/pom.xml</relativePath>
  </parent>

  <artifactId>stratum-starter-data-jpa</artifactId>

  <name>Stratum starter: data JPA</name>
  <description>Spring Data JPA with safe defaults for the connection pool, Hibernate and transactions.</description>

  <!-- Only partly built, so not published to Maven Central yet and not in stratum-bom
       (docs/contributing.md#publishing). -->
  <properties>
    <skipPublishing>true</skipPublishing>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.exepex.stratum</groupId>
      <artifactId>stratum-core</artifactId>
    </dependency>
    <!-- The JDBC boundary and the pool and transaction defaults every data starter shares. It is
         not in stratum-bom until it is published (docs/contributing.md#publishing), so its
         version is this build's own. -->
    <dependency>
      <groupId>io.github.exepex.stratum</groupId>
      <artifactId>stratum-data</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Spring Boot's own JPA starter: Hibernate and Spring Data JPA, which this module gives
         its defaults. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- The two web starters, for the tests of the answer to a request whose statement Stratum
         cancelled, on both stacks (ADR 0006). -->
    <dependency>
      <groupId>io.github.exepex.stratum</groupId>
      <artifactId>stratum-starter-webmvc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.exepex.stratum</groupId>
      <artifactId>stratum-starter-webflux</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The JDBC starter, for the unit test that proves a service with both data starters gets
         each bean and default once. Failsafe leaves it out, below. -->
    <dependency>
      <groupId>io.github.exepex.stratum</groupId>
      <artifactId>stratum-starter-jdbc</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The checks and set-up that every starter's tests share, and the PostgreSQL container that
         stratum-test declares optional. -->
    <dependency>
      <groupId>io.github.exepex.stratum</groupId>
      <artifactId>stratum-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Boot's health contributors, to prove that the db health check still reaches the
         wrapped pool. Services bring them with the actuator. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-health</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Batch on the classpath, to prove that the module then sets no transaction timeout.
         Services bring their own. -->
    <dependency>
      <groupId>org.springframework.batch</groupId>
      <artifactId>spring-batch-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Micrometer and the PostgreSQL driver, which stratum-data declares optional, as a service
         brings them, for the integration tests. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Flyway and Liquibase as a service adds them, to prove their connections get the boundary. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-liquibase</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- JMH, for the request time left benchmark, which only the benchmark profile below runs. -->
    <dependency>
      <groupId>org.openjdk.jmh</groupId>
      <artifactId>jmh-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The integration tests run without the JDBC starter, so that its spring.factories and
           auto-configuration imports cannot stand in for this starter's own. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <classpathDependencyExcludes>
            <classpathDependencyExclude>io.github.exepex.stratum:stratum-starter-jdbc</classpathDependencyExclude>
          </classpathDependencyExcludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Measures what reading a web request's time left costs, with no database. The JDBC
         boundary's benchmarks are in stratum-data. Run on demand only; docs/contributing.md
         gives the command. -->
    <profile>
      <id>benchmark</id>
      <properties>
        <jmh.benchmarks>RequestTimeLeftBenchmark</jmh.benchmarks>
      </properties>
      <build>
        <plugins>
          <!-- JMH's generator, added to the processors the library parent lists, so that the test
               compile writes the benchmark code and META-INF/BenchmarkList. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <annotationProcessorPaths combine.children="append">
                <path>
                  <groupId>org.openjdk.jmh</groupId>
                  <artifactId>jmh-generator-annprocess</artifactId>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </plugin>
          <!-- antrun launches JMH because Spring Boot already manages it, so the build needs no new
               plugin (ST-ENG-62). It passes no argLine, so JaCoCo's agent stays out of the
               benchmark, and -jvmArgs stops JMH's forks from copying this JVM's arguments. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>stratum-jmh</id>
                <phase>integration-test</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <java classname="org.openjdk.jmh.Main" classpathref="maven.test.classpath"
                        fork="true" failonerror="true">
                      <arg value="-jvmArgs"/>
                      <arg value="-Xms1g -Xmx1g"/>
                      <arg value="-rf"/>
                      <arg value="json"/>
                      <arg value="-rff"/>
                      <arg value="${project.build.directory}/jmh-result.json"/>
                      <arg value="${jmh.benchmarks}"/>
                    </java>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
