<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.exepex.stratum</groupId>
    <artifactId>stratum-library-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/stratum-library-parent/pom.xml</relativePath>
  </parent>

  <artifactId>stratum-starter-webflux</artifactId>

  <name>Stratum starter: WebFlux</name>
  <description>Spring WebFlux for a reactive service, with Stratum's error format, request fields in logs and the correlation ID. Planned: request log and timeouts.</description>

  <dependencies>
    <dependency>
      <groupId>com.exepex.stratum</groupId>
      <artifactId>stratum-web</artifactId>
    </dependency>
    <!-- The service's web server: Spring WebFlux on Netty. A service that is not reactive uses
         stratum-starter-webmvc instead, so the two stacks never meet in one service. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <!-- Sets the correlation ID in the tracing baggage. The observability starter brings it; without
         it, requests get no correlation ID. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing</artifactId>
      <optional>true</optional>
      <!-- Spring AOP already holds these classes. -->
      <exclusions>
        <exclusion>
          <groupId>aopalliance</groupId>
          <artifactId>aopalliance</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- The checks and set-up that every starter's tests share. -->
    <dependency>
      <groupId>com.exepex.stratum</groupId>
      <artifactId>stratum-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Puts trace and correlation IDs in the logging context, to prove that error bodies carry
         them. Services add it themselves. -->
    <dependency>
      <groupId>com.exepex.stratum</groupId>
      <artifactId>stratum-starter-observability</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Calls the test service from itself, to prove the correlation ID reaches the services a
         request calls. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webclient</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
