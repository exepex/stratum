<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.exepex.stratum</groupId>
    <artifactId>stratum-library-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/stratum-library-parent/pom.xml</relativePath>
  </parent>

  <artifactId>stratum-starter-cache</artifactId>

  <name>Stratum starter: cache</name>
  <description>Spring's caching switched on, with bounded Caffeine caches by default and safe Redis defaults on Spring Boot's own keys.</description>

  <dependencies>
    <dependency>
      <groupId>com.exepex.stratum</groupId>
      <artifactId>stratum-core</artifactId>
    </dependency>
    <!-- Spring Boot's own cache starter: Spring's caching and Spring Boot's cache set-up, which this
         module switches on and gives its defaults. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <!-- Spring Boot's Redis set-up, Spring Data Redis and Lettuce, for the customizer that clears
         Redis caches with SCAN. Optional: a service chooses Redis by adding
         spring-boot-starter-data-redis itself. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-data-redis</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Caffeine, so that a service without Redis gets bounded, measured Caffeine caches with
         Stratum's defaults. Spring Boot picks Redis before Caffeine once the service adds it. -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <!-- Jackson, which stores Redis cache values as plain JSON. Optional: only Redis caches need it,
         and a service on Redis without it stops at startup with SX-CACHE-1007. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Micrometer's registry, for the counters of failed cache calls and refused cache names.
         Optional: without it the counters are no-ops and the rest of the layer works unchanged. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Micrometer's observation API, for the filter that puts the cache name on Redis spans.
         Optional: Spring Boot brings it with metrics or tracing, and without it no filter is made. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-observation</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- The checks and set-up that every starter's tests share, and the Redis container that
         stratum-test declares optional. -->
    <dependency>
      <groupId>com.exepex.stratum</groupId>
      <artifactId>stratum-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Boot's metrics, to prove that cache hits are counted. Services bring them with the
         actuator. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-metrics</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Boot's tracing with OpenTelemetry, without an exporter, and OpenTelemetry's in-memory
         exporter, to prove that Redis spans carry the cache name. Services bring tracing with the
         observability starter. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
