<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.exepex.stratum</groupId>
    <artifactId>stratum-library-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/stratum-library-parent/pom.xml</relativePath>
  </parent>

  <artifactId>stratum-starter-http-client</artifactId>

  <name>Stratum starter: HTTP client</name>
  <description>Blocking clients of other services: @StratumClient interfaces on RestClient and Apache HttpClient 5, each with its own timeouts and bounded connection pool.</description>

  <dependencies>
    <dependency>
      <groupId>com.exepex.stratum</groupId>
      <artifactId>stratum-http-client</artifactId>
    </dependency>
    <!-- Spring Boot's RestClient set-up and Spring's HTTP service groups, which turn each
         @StratumClient interface into a client. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <!-- Sends the calls of Stratum's clients. Unlike Java's own client, it has a connection pool per
         client that can be bounded, a wait for a free connection and a connection lifetime. -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
    </dependency>
    <!-- The one retry layer and the circuit breaker of each client (ADR 0011, decision 4.1),
         for its interfaces and its RestClient and RestTemplate beans (ADR 0014). Spring Boot does
         not manage Resilience4j; a client with its own engine gets them in the planned #262. -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-retry</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
    </dependency>
    <!-- Spring's test framework, for the listener that clears the mocks of MockClient after each
         test. Optional: a running service never loads the listener, and a team's tests already
         have it through spring-boot-starter-test. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- The web starter's error answers, to check the statuses this starter gives its codes. -->
    <dependency>
      <groupId>com.exepex.stratum</groupId>
      <artifactId>stratum-web</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Optional: the service token of auth.client-credentials, which a team gets by adding
         stratum-starter-oauth2-client, and the caller's verified token of auth.token-relay, which
         Spring Security's resource server puts in the security context. Stratum's OAuth parts load
         only when these are present. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-client</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-resource-server</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- The checks and set-up that every starter's tests share. -->
    <dependency>
      <groupId>com.exepex.stratum</groupId>
      <artifactId>stratum-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The registrations of client-credentials, as a team gets them with the starter. -->
    <dependency>
      <groupId>com.exepex.stratum</groupId>
      <artifactId>stratum-starter-oauth2-client</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- A verified JWT in the security context, as the resource server leaves it, for relay. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Reactor, for the client with a Mono method that the blocking starter refuses at startup. -->
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Jackson 2, which a team can still choose for its clients' JSON, so that the tests read bad
         and cut-off bodies with the real converter. Test scope only: Stratum's own code needs no
         Jackson 2, and no other dependency gives its converter's real failures (ST-ENG-62). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
