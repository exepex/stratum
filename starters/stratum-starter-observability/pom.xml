<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.exepex.stratum</groupId>
    <artifactId>stratum-library-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../platform/stratum-library-parent/pom.xml</relativePath>
  </parent>

  <artifactId>stratum-starter-observability</artifactId>

  <name>Stratum starter: observability</name>
  <description>Metrics, traces and health, sent over OTLP to an OpenTelemetry Collector, with safe defaults.</description>

  <dependencies>
    <dependency>
      <groupId>com.exepex.stratum</groupId>
      <artifactId>stratum-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Brings Micrometer's OTLP metrics registry and the OpenTelemetry tracing bridge and exporter. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <!-- Already brought at runtime by the OpenTelemetry starter, with the same exclusion; compiled
         against because the correlation ID listens to its tracing context events. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
      <exclusions>
        <exclusion>
          <groupId>aopalliance</groupId>
          <artifactId>aopalliance</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Parses the URLs recorded on HTTP client spans. Only present when the service uses Spring's HTTP
         clients, which are the only source of those spans. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Kafka and JMS brokers that run inside the test JVM, to prove that traces, timings and the
         correlation ID cross a message. Services bring their own messaging libraries. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-artemis</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.activemq</groupId>
      <artifactId>artemis-jakarta-server</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
