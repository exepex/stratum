<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stratum's Checkstyle, PMD and Maven Enforcer rules, packaged as a jar so that stratum-build-parent
  can load them from the classpath in every build. Its parent is the root POM: stratum-build-parent
  depends on it, so it cannot inherit stratum-build-parent. Its versions, and the PMD version its tests
  check the rules with, come from the root POM, so they match the ones stratum-build-parent runs.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.exepex.stratum</groupId>
    <artifactId>stratum</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>stratum-build-rules</artifactId>
  <packaging>jar</packaging>

  <name>Stratum build rules</name>
  <description>Checkstyle, PMD and Maven Enforcer rules that every Stratum and service build is checked against.</description>

  <!-- Tests for the PMD rules in stratum/pmd-lombok.xml, with PMD's own rule-test harness. -->
  <dependencies>
    <dependency>
      <groupId>net.sourceforge.pmd</groupId>
      <artifactId>pmd-java</artifactId>
      <version>${pmd.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.sourceforge.pmd</groupId>
      <artifactId>pmd-test</artifactId>
      <version>${pmd.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
