<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stratum's Checkstyle, PMD and Maven Enforcer rules, packaged as a jar so that stratum-build-parent
  can load them from the classpath in every build. Its parent is the reactor POM: stratum-build-parent
  depends on it, so it cannot inherit stratum-build-parent.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.exepex.stratum</groupId>
    <artifactId>stratum</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>stratum-build-rules</artifactId>
  <packaging>jar</packaging>

  <name>Stratum build rules</name>
  <description>Checkstyle, PMD and Maven Enforcer rules that every Stratum and service build is checked against.</description>

  <properties>
    <!-- The JUnit version Spring Boot manages and the PMD version stratum-build-parent runs. This module
         cannot inherit that parent, so update these when that parent's versions change. -->
    <junit-jupiter.version>6.1.3</junit-jupiter.version>
    <maven.compiler.release>25</maven.compiler.release>
    <pmd.version>7.28.0</pmd.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- Tests for the PMD rules in stratum/pmd-lombok.xml, with PMD's own rule-test harness. -->
  <dependencies>
    <dependency>
      <groupId>net.sourceforge.pmd</groupId>
      <artifactId>pmd-java</artifactId>
      <version>${pmd.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.sourceforge.pmd</groupId>
      <artifactId>pmd-test</artifactId>
      <version>${pmd.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit-jupiter.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
