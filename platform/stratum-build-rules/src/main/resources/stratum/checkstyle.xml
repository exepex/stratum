<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Stratum's Checkstyle rules. Layout (indentation, line length, import order, whitespace) is left to
  google-java-format, which Spotless checks, so these rules cover what a formatter cannot: Javadoc,
  names, imports and risky constructs. Rule IDs in comments point to docs/agents/.
  No check counts lines: file size is checked by agents and the judge (AGENTS.md, ST-AG-10).
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="NewlineAtEndOfFile"/>

  <module name="TreeWalker">
    <!-- Javadoc on every type and method (ST-ENG-14). Tests use @DisplayName instead. -->
    <module name="MissingJavadocType">
      <property name="scope" value="private"/>
      <property name="skipAnnotations" value="Generated, DisplayName"/>
    </module>
    <module name="MissingJavadocMethod">
      <property name="scope" value="private"/>
      <property name="allowMissingPropertyJavadoc" value="false"/>
      <property name="allowedAnnotations"
          value="Override, Test, ParameterizedTest, RepeatedTest, TestFactory, TestTemplate"/>
      <property name="tokens" value="METHOD_DEF, CTOR_DEF, ANNOTATION_FIELD_DEF, COMPACT_CTOR_DEF"/>
    </module>
    <module name="InvalidJavadocPosition"/>
    <module name="JavadocMethod">
      <property name="accessModifiers" value="public, protected, package, private"/>
    </module>
    <module name="NonEmptyAtclauseDescription"/>
    <!-- A summary sentence that says what the element does, not its signature (ST-ENG-15) -->
    <module name="SummaryJavadoc">
      <property name="forbiddenSummaryFragments"
          value="^@return the *|^This method returns |^A [{]@code [a-zA-Z0-9]+[}]( is a )"/>
    </module>

    <!-- Names (ST-ENG-13) -->
    <module name="ConstantName"/>
    <module name="LocalVariableName"/>
    <module name="MemberName"/>
    <module name="MethodName"/>
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>
    <module name="ParameterName"/>
    <module name="TypeName"/>

    <!-- Imports -->
    <module name="AvoidStarImport"/>
    <module name="IllegalImport"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>

    <!-- Clean code (ST-ENG-08, ST-ENG-45) -->
    <module name="EmptyBlock"/>
    <module name="EmptyCatchBlock"/>
    <module name="EqualsHashCode"/>
    <module name="FallThrough"/>
    <module name="InnerAssignment"/>
    <module name="MagicNumber">
      <property name="ignoreAnnotation" value="true"/>
      <property name="ignoreHashCodeMethod" value="true"/>
    </module>
    <module name="ModifiedControlVariable"/>
    <module name="MultipleVariableDeclarations"/>
    <module name="NeedBraces"/>
    <module name="NestedIfDepth">
      <property name="max" value="2"/>
    </module>
    <module name="NestedTryDepth"/>
    <module name="OneStatementPerLine"/>
    <module name="ParameterNumber">
      <property name="ignoreAnnotatedBy" value="Bean"/>
    </module>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="StringLiteralEquality"/>

    <!-- Logging goes through SLF4J (ST-SEC-02); tests wait with Awaitility (ST-TEST-14) -->
    <module name="RegexpSinglelineJava">
      <property name="id" value="noConsoleOutput"/>
      <property name="format" value="System\.(out|err)\.|\.printStackTrace\(\)"/>
      <property name="ignoreComments" value="true"/>
      <property name="message" value="Log through SLF4J instead of the console (ST-SEC-02)."/>
    </module>
    <module name="RegexpSinglelineJava">
      <property name="id" value="noThreadSleep"/>
      <property name="format" value="Thread\.sleep\("/>
      <property name="ignoreComments" value="true"/>
      <property name="message" value="Do not sleep; wait with Awaitility and a timeout (ST-TEST-14)."/>
    </module>
  </module>
</module>
