<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stratum's PMD rules: the PMD categories that find bugs, unsafe code and wasted work. Each rule
  excluded below conflicts with a Stratum convention; the comment says which.
-->
<ruleset name="Stratum"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
  <description>Rules every Stratum module and every service built on stratum-parent is checked against.</description>

  <rule ref="category/java/bestpractices.xml">
    <!-- AssertJ chains several assertions about one result; a message per assertion adds nothing. -->
    <exclude name="UnitTestAssertionsShouldIncludeMessage"/>
    <exclude name="UnitTestContainsTooManyAsserts"/>
  </rule>
  <rule ref="category/java/errorprone.xml">
    <exclude name="AvoidCatchingGenericException"/>
  </rule>
  <!--
    The logging starter's redactor must hide any value that fails while it is masked, such as a
    toString() that throws a NullPointerException, so that a secret is never written and the rest
    of the log line is kept. The owner allowed that one method to catch RuntimeException
    (2026-11-02).
    The cache starter's StratumCache runs a cached method's loader at most once: when the write
    after a load fails, get catches the failure and returns the loaded value, and afterFailedWrite
    catches the service handler's error to pass it on without a second report. Any cache failure
    is a RuntimeException, so the owner allowed those two methods too (2026-11-04).
    The web MVC starter's ResponseTimeoutFilter answers a request that ran out of time with the
    timeout status whatever the rest of the chain fails with, and a filter after it, such as
    Spring Security's or the service's own, can fail with any unchecked exception. The owner
    allowed its doFilterInternal too (2026-11-05). Every other method is still checked.
  -->
  <rule ref="category/java/errorprone.xml/AvoidCatchingGenericException">
    <properties>
      <property name="violationSuppressXPath"
          value="./ancestor::MethodDeclaration[@Name='failingClosed']
              [ancestor::ClassDeclaration[@SimpleName='Redactor']]
              [ancestor::CompilationUnit/PackageDeclaration[@Name='com.exepex.stratum.logging.redaction']]
            | ./ancestor::MethodDeclaration[@Name='get' or @Name='afterFailedWrite']
              [ancestor::ClassDeclaration[@SimpleName='StratumCache']]
              [ancestor::CompilationUnit/PackageDeclaration[@Name='com.exepex.stratum.cache']]
            | ./ancestor::MethodDeclaration[@Name='doFilterInternal']
              [ancestor::ClassDeclaration[@SimpleName='ResponseTimeoutFilter']]
              [ancestor::CompilationUnit/PackageDeclaration[@Name='com.exepex.stratum.webmvc']]"/>
    </properties>
  </rule>
  <rule ref="category/java/multithreading.xml">
    <!-- A Java EE rule: Stratum manages threads through Spring's bounded executors (ST-ENG-52). -->
    <exclude name="DoNotUseThreads"/>
  </rule>
  <rule ref="category/java/performance.xml"/>
  <rule ref="category/java/security.xml"/>
</ruleset>
