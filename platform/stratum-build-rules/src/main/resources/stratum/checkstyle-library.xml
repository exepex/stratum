<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Rules for Stratum's own code only: Javadoc (ST-ENG-14, ST-ENG-15) and the 400-line limit on Java
  files (ST-AG-10). Only stratum-library-parent runs them, for Stratum's libraries and starters.
  Services are not checked, because whether a service writes Javadoc, and how long its files are, is
  its team's choice.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!-- No Java file over 400 lines, tests included (ST-AG-10, ST-TEST-41) -->
  <module name="FileLength">
    <property name="max" value="400"/>
  </module>

  <module name="TreeWalker">
    <!-- Javadoc on every type and method (ST-ENG-14). Tests use @DisplayName instead. -->
    <module name="MissingJavadocType">
      <property name="scope" value="private"/>
      <property name="skipAnnotations" value="Generated, DisplayName"/>
    </module>
    <module name="MissingJavadocMethod">
      <property name="scope" value="private"/>
      <property name="allowMissingPropertyJavadoc" value="false"/>
      <property name="allowedAnnotations"
          value="Override, Test, ParameterizedTest, RepeatedTest, TestFactory, TestTemplate"/>
      <property name="tokens" value="METHOD_DEF, CTOR_DEF, ANNOTATION_FIELD_DEF, COMPACT_CTOR_DEF"/>
    </module>
    <!-- An @param for every record component and type parameter: a settings record's @param text is
         the property description IDEs show (ST-DOC-04). -->
    <module name="JavadocType">
      <property name="scope" value="private"/>
    </module>
    <module name="InvalidJavadocPosition"/>
    <module name="JavadocMethod">
      <property name="accessModifiers" value="public, protected, package, private"/>
    </module>
    <module name="NonEmptyAtclauseDescription"/>
    <!-- A summary sentence that says what the element does, not its signature (ST-ENG-15) -->
    <module name="SummaryJavadoc">
      <property name="forbiddenSummaryFragments"
          value="^@return the *|^This method returns |^A [{]@code [a-zA-Z0-9]+[}]( is a )"/>
    </module>
  </module>
</module>
