<?xml version="1.0" encoding="UTF-8"?>
<!--
  The parent POM for services built on Stratum. Versions and build checks come from
  stratum-build-parent; this POM adds what only a service needs: the executable jar, and the
  build-info.properties and git.properties files that /actuator/info shows. Stratum's own libraries do
  not inherit this POM, because a library jar that carried those two files would hide the service's own.
  Services are not checked for Javadoc; that check is in stratum-library-parent.
  Keep <plugins> sorted by name.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.exepex.stratum</groupId>
    <artifactId>stratum-build-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../stratum-build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>stratum-parent</artifactId>
  <packaging>pom</packaging>

  <name>Stratum parent</name>
  <description>Parent POM for services: Stratum's versions and build checks, plus the executable jar and build info.</description>

  <build>
    <plugins>
      <plugin>
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
      </plugin>
      <!-- This POM is flattened when it is installed, but a service has its own version, so the
           flatten executions stop here. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>stratum-flatten</id>
            <inherited>false</inherited>
          </execution>
          <execution>
            <id>stratum-flatten-clean</id>
            <inherited>false</inherited>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>stratum-build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
