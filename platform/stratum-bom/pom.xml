<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stratum's bill of materials: the versions of Stratum's modules and of the libraries Stratum uses that
  Spring Boot does not manage. The version numbers are properties of the root POM, its parent.
  The root POM inherits Spring Boot's parent, so the installed BOM is flattened in "bom" mode: it has
  no parent and manages only the entries below. It also carries the root POM's properties, so that
  the versions below resolve when a service imports it; Maven imports only <dependencyManagement>, so
  those properties do not change the service. The BOM never brings Spring Boot's versions, so a
  service under a company parent gets them from that parent only (ADR 0001, ST-ENG-60).
  Keep <dependencyManagement> sorted by name.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.exepex.stratum</groupId>
    <artifactId>stratum</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>stratum-bom</artifactId>
  <packaging>pom</packaging>

  <name>Stratum BOM</name>
  <description>Versions of Stratum's modules and of the extra libraries Stratum uses.</description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-http-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-batch</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-cache</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-data-jpa</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-http-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-kafka</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-logging</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-microservice</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-oauth2-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-observability</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-reactive-http-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-reactive-microservice</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-resilience</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-web-ui</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-webflux</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-starter-webmvc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-test</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.exepex.stratum</groupId>
        <artifactId>stratum-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.googlecode.libphonenumber</groupId>
        <artifactId>libphonenumber</artifactId>
        <version>${libphonenumber.version}</version>
      </dependency>
      <dependency>
        <groupId>com.maxmind.db</groupId>
        <artifactId>maxmind-db</artifactId>
        <version>${maxmind-db.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>commons-validator</groupId>
        <artifactId>commons-validator</artifactId>
        <version>${commons-validator.version}</version>
      </dependency>
      <dependency>
        <groupId>nl.basjes.parse.useragent</groupId>
        <artifactId>yauaa</artifactId>
        <version>${yauaa.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct-processor</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>org.projectlombok</groupId>
        <artifactId>lombok-mapstruct-binding</artifactId>
        <version>${lombok-mapstruct-binding.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <flattenMode>bom</flattenMode>
          <!-- Spring's project URL, developers and SCM, inherited through the root POM, are not Stratum's. -->
          <pomElements>
            <developers>remove</developers>
            <issueManagement>remove</issueManagement>
            <scm>remove</scm>
            <url>remove</url>
          </pomElements>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
